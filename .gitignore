# This repo is a hand-written static site. Nothing here is generated at build
# time, so this .gitignore exists purely to keep OS/editor/tooling junk out.

# ---- macOS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# ---- Windows ----
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ---- Linux ----
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---- Editors / IDEs ----
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
.history/
.project
.settings/
nbproject/
*.swp
*.swo
*.tmp
*.bak
*.orig
*.rej

# ---- Logs & temp ----
*.log
*.temp
logs/
tmp/
temp/

# ---- Node (only if tooling is ever added) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.cache/
dist/
.parcel-cache/
.sass-cache/

# ---- Python (only if helper scripts are ever added) ----
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*

# ---- Local previews / headless-render artifacts ----
*.local
og-*.png.tmp
.chrome-tmp/
